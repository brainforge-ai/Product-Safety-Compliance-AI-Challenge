# Copy this file to .env and fill in real values as needed.
# The app must run with zero configuration beyond this file's defaults,
# per the "deterministic-first, AI-assisted fallback" principle in
# docs/ARCHITECTURE.md.

# --- Optional AI matching tiers (Section 6/7 of ARCHITECTURE.md) ---
# Both tiers require `pip install -r requirements-ai.txt` (sentence-transformers,
# pydantic-ai) in addition to the base requirements.txt.
ENABLE_LLM_MATCHING=false
LLM_PROVIDER=pydantic_ai
LLM_MODEL=google:gemini-3.1-flash-lite
GOOGLE_API_KEY=
LLM_TIMEOUT_SECONDS=20.0

ENABLE_EMBEDDING_MATCHING=false

# --- Persistence (Section 8 of ARCHITECTURE.md) ---
ENABLE_PERSISTENCE=false
DATABASE_URL=sqlite:///./data/app.db

# --- Request resource bounds ---
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_FILES=20

# --- Sample dataset locations (Section 2/10 of ARCHITECTURE.md) ---
# Both default to the repo-root images/pdfs/texts/product_index.csv and
# forbidden_ingredients.csv. Leave commented out unless pointing at a
# different dataset location — an empty value is NOT the same as unset for
# these (it would resolve to a Path of "."), so don't uncomment blank.
# DEFAULT_FORBIDDEN_LIST_PATH=/path/to/forbidden_ingredients.csv
# SAMPLE_DATA_DIR=/path/to/sample/data
