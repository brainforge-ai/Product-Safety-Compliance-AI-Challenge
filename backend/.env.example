# Copy this file to .env and fill in real values as needed.
# The app must run with zero configuration beyond this file's defaults,
# per the "deterministic-first, AI-assisted fallback" principle in
# docs/ARCHITECTURE.md.

# --- Optional AI matching tiers (Section 6/7 of ARCHITECTURE.md) ---
ENABLE_LLM_MATCHING=false
LLM_PROVIDER=pydantic_ai
LLM_MODEL=google:gemini-3.1-flash-lite
GOOGLE_API_KEY=

ENABLE_EMBEDDING_MATCHING=false

# --- Persistence (Section 8 of ARCHITECTURE.md) ---
ENABLE_PERSISTENCE=false
DATABASE_URL=sqlite:///./data/app.db
